# Caso de teste de codegen — regressão com LinearRegression
DATASET "tests/codegen/data/regression.csv"
  COLUMNS area, quartos, banheiros, garagem, preco
END

TARGET_VAR preco
FEATURES area, quartos, banheiros, garagem

MODEL reg LinearRegression
END

METRICS RMSE, MAE, R2
OUTPUT "tests/codegen/output/regression_model.pkl"
